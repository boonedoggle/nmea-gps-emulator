[Unit]
Description=NMEA GPS fallback source selector
Requires=gpsd.service nmea_gps_emulator.service
After=gpsd.service nmea_gps_emulator.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m nmea_gps_emulator.gpsd_fallback
Restart=always
RestartSec=2
StandardOutput=journal

[Install]
WantedBy=multi-user.target
